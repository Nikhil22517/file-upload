{
  "name": "@platform/ingestion-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "upload-folder": "tsx --env-file-if-exists=.env scripts/upload-folder.ts",
    "postman": "npx -y newman@6 run postman/ingestion-api.postman_collection.json --working-dir postman",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@platform/db": "workspace:*",
    "@platform/ingestion": "workspace:*",
    "@platform/ingestion-service": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "tsx": "^4.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
