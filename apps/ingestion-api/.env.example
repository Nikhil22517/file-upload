# Copy to .env for local runs (`pnpm dev`). Values match docker-compose.yml in this folder.
DATABASE_URL=postgresql://lmd:lmd@localhost:5432/lmd
STORAGE_DIR=./data/files
PORT=8000
# Uploads by URL: hosts the API may download from (comma-separated, e.g. your bucket). Empty = any host.
FILE_URL_HOSTS=
# Keep uploaded originals after their import (needed for re-import). Default false.
KEEP_FILES=false
