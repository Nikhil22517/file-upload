# Copy to .env. The web app reads and writes the same Postgres and upload folder as the ingestion API,
# so a file uploaded here can be confirmed through the API and the other way round.
DATABASE_URL=postgresql://lmd:lmd@localhost:5432/lmd
STORAGE_DIR=../ingestion-api/data/files
# Port for `pnpm start` (the production build); `pnpm dev` always uses 3000.
PORT=3001
# Where the database migrations are, for `pnpm start` (the bundled build can't find them by itself).
MIGRATIONS_DIR=../../packages/db/drizzle
